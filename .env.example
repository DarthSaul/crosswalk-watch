# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Backend (optional overrides; all prefixed CROSSWALK_)
# CROSSWALK_MAX_UPLOAD_MB=200
# CROSSWALK_THUMBNAIL_SECONDS=1.0

# Detection tuning — bump these if pedestrians are getting missed
# CROSSWALK_YOLO_WEIGHTS=yolo11n.pt        # try yolo11s.pt for better recall
# CROSSWALK_YOLO_IMGSZ=640                 # try 1280 for far-away pedestrians (3-4× slower)
# CROSSWALK_YOLO_CONF=0.25                 # try 0.15 for more tentative detections
